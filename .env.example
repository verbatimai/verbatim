# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# In the desktop app these are stored in the OS keychain, NOT in a .env file;
# this file is for local development / the optional backend only.

# ---- Provider selection ----
# STT_PROVIDER options: pyai | deepgram | openai
STT_PROVIDER=pyai
# CORRECTION_PROVIDER options: openai | anthropic (pyai removed as a correction vendor)
CORRECTION_PROVIDER=openai

# ---- Vendor keys (BYOK) — set only the ones you use ----
PYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Optional overrides ----
# PORT=8787
# PYAI_MODEL=gpt-5.6-sol
# PYAI_BASE=https://api.pyai.com/v1
